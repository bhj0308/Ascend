# Application
APP_NAME=Ascend
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
# LOCAL: postgresql://postgres:postgres@localhost:5432/ascend_dev
# DOCKER: postgresql://postgres:postgres@db:5432/ascend_dev
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ascend_dev
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30

# Redis
# LOCAL: redis://localhost:6379/0
# DOCKER: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_EXPIRE_SECONDS=3600

# JWT / Authentication
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"  (required in production)
SECRET_KEY=your-super-secret-key-change-in-production-make-it-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (Get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/callback/google

# CORS origins and trusted hosts (comma-separated). In production set your
# frontend origin(s) and API hostname.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Email / SendGrid (Get API key from SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@ascendtalent.com

# Wise (Cross-border payments - Get from Wise API Console)
WISE_API_KEY=
WISE_API_URL=https://api.wise.com

# DocuSign (E-signatures - Get from DocuSign Developer Console)
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_API_URL=https://demo.docusign.net

# Sentry (Error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Feature Flags
ENABLE_WISE_PAYMENTS=False
ENABLE_DOCUSIGN=False
ENABLE_GOOGLE_OAUTH=False
